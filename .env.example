# Copia este archivo a .env (está en .gitignore) y completa los valores.

# --- Microsoft Entra ID (ver docs/DESPLIEGUE-AWS-AZURE.md) ---
ENTRA_TENANT_ID=<Directory (tenant) ID>
ENTRA_API_CLIENT_ID=<Application (client) ID del registro de la API/BFF>
ENTRA_SPA_CLIENT_ID=<Application (client) ID del registro del front (SPA)>

# --- RabbitMQ ---
RABBITMQ_USER=vidasalud
RABBITMQ_PASSWORD=cambia_esta_clave
RABBITMQ_ERLANG_COOKIE=cambia_esta_cookie_larga_y_aleatoria

# --- PostgreSQL ---
POSTGRES_USER=vidasalud
POSTGRES_PASSWORD=cambia_esta_clave

# Orígenes permitidos por CORS en el BFF (separados por coma)
FRONTEND_URLS=http://localhost:4200,http://localhost:3000

# --- Front público (HTTPS con Caddy) ---
# Nombre público del sitio: <IP-con-puntos>.sslip.io (ej. 3.211.254.27.sslip.io) o tu dominio
SITE_HOST=
# URL de API Gateway que usa el front (sin / final)
API_BASE_URL=
